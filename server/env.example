# Database — Supabase (recommended for Railway + this app)
# In Supabase: Project Settings → Database → Connection string → URI
# Prefer "Session pooler" (port 5432 on *.pooler.supabase.com) for node-pg on Railway.
# Or "Transaction pooler" (port 6543) with ?pgbouncer=true in the URI.
#
# Example (replace with your project values):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Do NOT use Railway Postgres and Supabase at the same time — point Railway Node only at Supabase.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
PG_SSL=1
PG_POOL_MAX=8
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=postgres
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=20000
PG_STATEMENT_TIMEOUT=120s
PG_QUERY_RETRY_ATTEMPTS=5
PG_QUERY_RETRY_DELAY_MS=500

# Application Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI Service Configuration
AI_SERVICE_BASE_URL=https://your-ai-service.railway.app
FASTAPI_INTERNAL_URL=https://your-ai-service.railway.app
AI_SERVICE_TOKEN=your-ai-service-token
AI_SERVICE_TIMEOUT_SEGMENT_MS=20000
AI_SERVICE_TIMEOUT_RECOLOR_MS=8000
AI_SERVICE_TIMEOUT_COMPOSE_MS=12000
AI_SERVICE_TIMEOUT_ADD_BY_PROMPT_MS=180000
AI_SERVICE_MAX_IMAGE_BYTES=8000000
AI_SERVICE_SEGMENT_TIMEOUT_RETRIES=1

# Email (Resend HTTPS API — do NOT use SMTP on Railway; port 465 often times out)
# RESEND_TIMEOUT_MS=20000
# Must be set on Railway (production), not only in local server/.env
RESEND_API_KEY=re_xxxxxxxx
# Until curatering.com DNS is verified in Resend, use the test sender:
RESEND_FROM=Curatering <onboarding@resend.dev>
# After domain verification at https://resend.com/domains :
# RESEND_FROM=Curatering <noreply@curatering.com>
# Optional: POST /api/health/email-test with body { "to": "you@email.com", "testSecret": "..." }
# EMAIL_TEST_SECRET=your-random-secret

# RunPod (server-side proxy for Flutter — set on API host e.g. Railway; never in the web bundle)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Rate limit for /api/public/runpod and /api/public/events/theme-design (per IP per minute)
PUBLIC_API_RATE_LIMIT_PER_MIN=20
# DISABLE_PUBLIC_RATE_LIMIT=1

# Pexels API (for theme suggestions)
PEXELS_API_KEY=your-pexels-api-key
PEXELS_MAX_ATTEMPTS=3

# Super Admin Seed (for initial setup)
SEED_SUPER_ADMIN_EMAIL=admin@curatering.com
SEED_SUPER_ADMIN_PASSWORD=change-this-password
SEED_SUPER_ADMIN_FULL_NAME=Super Admin

# Database Initialization Retry (useful when Supabase pooler is cold-starting)
DB_INIT_RETRY_ATTEMPTS=12
DB_INIT_RETRY_DELAY_MS=3000
# Retry full bootstrap in background after failure (do not exit process — avoids Railway crash loops)
DB_INIT_BACKGROUND_RETRY_MS=30000
# Set to 1 only for local debugging if you want the process to stop on init failure
# DB_INIT_FATAL=1

# Static Files (Flutter Web Build)
WEB_BUILD_PATH=/app/build/web
